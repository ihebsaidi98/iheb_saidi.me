# Copy this file to ai-service/.env and fill in your values.
# NEVER commit ai-service/.env.
# Shared secret between Next.js and the AI service. There is NO built-in
# default. It must be exactly the same value as AI_SERVICE_TOKEN in the
# Next.js .env.local. Generate it once with `python scripts/setup-env.py`
# (or `openssl rand -hex 32`).
# While it is empty or shorter than 32 characters, production/staging refuse
# to start and development rejects every internal call.
AI_SERVICE_TOKEN=
GEMINI_API_KEY=AIza...same_key
ENVIRONMENT=development
