# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
GEMINI_API_KEY=AIza...your_real_key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_SERVICE_URL=http://localhost:8001
# Shared secret between Next.js and the AI service. There is NO built-in
# default: while this is empty, internal AI calls are not attempted and the
# interview endpoints answer 503. Generate it once with
# `python scripts/setup-env.py` (or `openssl rand -hex 32`) and use exactly the
# same value as AI_SERVICE_TOKEN in ai-service/.env.
AI_SERVICE_TOKEN=
# AI_SERVICE_ENABLED: Kill switch for the server-to-server AI service delegation.
# Only the literal "false" disables it: any other value, or leaving it unset, keeps it enabled.
# AI_SERVICE_ENABLED=true
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=60000
INTERVIEW_RATE_LIMIT=15
INTERVIEW_RATE_WINDOW_MS=60000
# Dedicated rate limit for POST /api/interview/complete (evaluates written answers via Gemini).
# INTERVIEW_RATE_LIMIT (15) covers /start and /submit.
# INTERVIEW_COMPLETE_RATE_LIMIT sets a nominal quota of 2 requests per 60s window.
# Under the Sliding Window Counter (SWC), a burst crossing an epoch boundary
# (e.g. 2 requests at t=59.9s and 2 requests at t=90.1s) can admit up to 4 requests
# within a rolling ~30s interval before 429 blocks further calls. This caps peak AI evaluations
# to at most 20 Gemini calls on that burst (down from 75+ previously).
INTERVIEW_COMPLETE_RATE_LIMIT=2
INTERVIEW_COMPLETE_RATE_WINDOW_MS=60000
# Reverse proxy trust. Keep "false" for direct development (`npm run dev`):
# client-supplied IP headers are then ignored entirely. The Docker Compose stack
# sets TRUSTED_PROXY=true explicitly for the frontend service, because there
# every request arrives through the bundled Nginx proxy.
TRUSTED_PROXY=false
# Header guaranteed by the reverse proxy when TRUSTED_PROXY=true. Defaults to
# x-forwarded-for, which is the header written by nginx/nginx.conf.
# Do not select cf-connecting-ip with the bundled Nginx: it deletes
# CF-Connecting-IP / True-Client-IP / X-Cluster-Client-IP and overwrites
# X-Real-IP, so every rate-limited route would answer 500 IP_VERIFICATION_FAILED.
# Behind a CDN or a load balancer, nginx/nginx.conf sees the proxy address, not
# the visitor: the per-IP rate limits then become one shared quota per proxy
# node. Resolving the client address there (set_real_ip_from + real_ip_header)
# and restricting access to the origin are deployment decisions, not configured
# in this repository.
TRUSTED_PROXY_HEADER=x-forwarded-for
# Optional: DEV_TO_API_KEY=optional
# Upper bound for a single Gemini call, in milliseconds.
LLM_TIMEOUT_MS=45000
# Rate limits for the public, unauthenticated read-only endpoints (per client IP).
# TECH_NEWS_RATE_LIMIT covers GET /api/tech-news (outbound feed aggregation).
# CSP_REPORT_RATE_LIMIT covers POST /api/csp-report: keep it generous, browsers
# may send several violation reports in a burst.
TECH_NEWS_RATE_LIMIT=30
TECH_NEWS_RATE_WINDOW_MS=60000
CSP_REPORT_RATE_LIMIT=60
CSP_REPORT_RATE_WINDOW_MS=60000
# Covers GET /api/ai/health, which probes the Python service on every call.
AI_HEALTH_RATE_LIMIT=60
AI_HEALTH_RATE_WINDOW_MS=60000
