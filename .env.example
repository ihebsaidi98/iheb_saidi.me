# =============================================================
# Portfolio Site — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================

# Google Gemini (server-side only, never exposed to the browser)
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended chat model: gemini-3.5-flash-lite or gemini-3.5-flash (gemini-2.5-flash is retired for new accounts)
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Chat rate limiting
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=60000

# Optional technology news integration
DEV_TO_API_KEY=your_devto_api_key

# Python AI Service (internal server-to-server proxy communication)
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=your_internal_service_token_here
