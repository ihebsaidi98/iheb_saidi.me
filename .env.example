# =============================================================
# Portfolio Site — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================

# --- AI Chatbot (server-side only, never exposed to the browser) ---

# Required: OpenAI API key for chat completions and text embeddings.
OPENAI_API_KEY=sk-REDACTED

# Optional: Chat model. Defaults to gpt-4o-mini.
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: Embedding model used by the RAG pipeline.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Rate Limiting ---

# Optional: Maximum chat requests per IP per window. Default: 10.
# CHAT_RATE_LIMIT=10

# Optional: Rate-limit window in milliseconds. Default: 60000 (1 minute).
# CHAT_RATE_WINDOW_MS=60000


OPENAI_API_KEY=sk-REDACTED
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=60000